{
  "name": "ai-virtual-pet",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "playtest:reset": "pnpm --filter @ai-virtual-pet/api playtest:reset",
    "playtest:advance": "pnpm --filter @ai-virtual-pet/api playtest:advance",
    "ai:smoke": "pnpm --filter @ai-virtual-pet/api ai:smoke"
  }
}
