{
  "name": "@ai-virtual-pet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:check": "tsx src/db/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playtest:reset": "tsx src/scripts/reset-pet.ts",
    "playtest:advance": "tsx src/scripts/advance-time.ts"
  },
  "dependencies": {
    "@ai-virtual-pet/contracts": "workspace:*",
    "@ai-virtual-pet/domain": "workspace:*",
    "@ai-virtual-pet/simulation": "workspace:*",
    "fastify": "^5.5.0",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
