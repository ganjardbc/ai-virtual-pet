DATABASE_URL="postgresql://YOUR_LOCAL_POSTGRES_USER@localhost:5432/ai_virtual_pet"
API_PORT=3000
# Separate database for persistence integration tests; tables are truncated during tests.
TEST_DATABASE_URL="postgresql://YOUR_LOCAL_POSTGRES_USER@localhost:5432/ai_virtual_pet_test"
# Development-only debug API (time travel, set state, reset). Never enable in production.
ENABLE_DEBUG_API=true
# AI provider (DEC-061): any OpenAI-compatible Chat Completions endpoint, e.g. 9router.
# Missing values leave the game playable with Talk unavailable. Check with: pnpm ai:smoke
AI_PROVIDER=openai-compatible
AI_BASE_URL="http://YOUR_9ROUTER_HOST/v1"
AI_MODEL="YOUR_MODEL_ID"
AI_API_KEY="YOUR_API_KEY"
# Send response_format json_object (only if the routed model supports it).
AI_JSON_MODE=false
AI_INTERPRETATION_TIMEOUT_MS=5000
AI_RESPONSE_TIMEOUT_MS=10000
AI_TURN_BUDGET_MS=15000
